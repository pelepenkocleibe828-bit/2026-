.container { padding: 40rpx 32rpx; background: #F8F7F5; min-height: 100vh; }

/* 个人名片 */
.user-card { display: flex; align-items: center; margin-bottom: 48rpx; padding: 0 10rpx;}
.avatar-placeholder { 
  width: 120rpx; height: 120rpx; background: #EBEAE5; 
  border-radius: 50%; display: flex; justify-content: center; align-items: center; 
  font-size: 64rpx; margin-right: 32rpx; border: 4rpx solid #FFFFFF;
}
.user-info { display: flex; flex-direction: column; }
.nickname { font-size: 44rpx; font-weight: 600; color: #2C2C2C; margin-bottom: 12rpx; }
.join-date { font-size: 26rpx; color: #76746F; }

/* 数据看板 */
.stats-card { 
  background: #FFFFFF; border-radius: 24rpx; padding: 40rpx 0; 
  display: flex; justify-content: center; align-items: center; margin-bottom: 40rpx; 
  border: 1rpx solid #EBEAE5;
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num { 
  font-size: 56rpx; font-weight: 700; color: #D97757; 
  margin-bottom: 12rpx; font-family: 'Times New Roman', Times, serif; 
}
.stat-label { font-size: 26rpx; color: #76746F; font-weight: 500;}
.divider { width: 2rpx; height: 60rpx; background: #EBEAE5; }

/* 徽章墙 */
.badge-card { 
  background: #FFFFFF; border-radius: 24rpx; padding: 40rpx 32rpx; 
  border: 1rpx solid #EBEAE5; 
}
.card-title { font-size: 32rpx; font-weight: 600; color: #2C2C2C; margin-bottom: 32rpx; }
.badge-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40rpx 20rpx; }
.badge-item { display: flex; flex-direction: column; align-items: center; }

/* 徽章基础样式 */
.badge-icon-wrap { 
  width: 110rpx; height: 110rpx; border-radius: 50%; 
  display: flex; justify-content: center; align-items: center; 
  font-size: 56rpx; margin-bottom: 16rpx; transition: all 0.3s ease;
}
.badge-name { font-size: 24rpx; color: #2C2C2C; font-weight: 500; text-align: center; }

/* 未获得状态 (灰色、半透明) */
.locked .badge-icon-wrap { background: #F4F4F4; filter: grayscale(100%); opacity: 0.5; }
.locked .badge-name { color: #A1A1A1; }

/* 已获得状态 (橘棕色强调) */
.owned .badge-icon-wrap { background: #FDF3EF; border: 4rpx solid #D97757; }
.owned .badge-name { color: #D97757; font-weight: 600;}

.empty-tip { grid-column: span 3; text-align: center; color: #A1A1A1; font-size: 26rpx; padding: 40rpx 0; }

/* 管理员入口 */
.admin-entry { margin-top: 80rpx; text-align: center; }
.admin-entry text { font-size: 24rpx; color: #A1A1A1; text-decoration: underline; letter-spacing: 2rpx;}