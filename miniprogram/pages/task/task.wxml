<view class="container">
  
  <!-- 顶部状态栏：如果没有任务，显示空提示 -->
  <view class="header">
    <text class="title">今日任务</text>
  </view>

  <!-- 无任务时的提示 -->
  <view class="empty-task" wx:if="{{!todayTask}}">
    <text>今日尚未发布任务，休息一下~</text>
  </view>

  <!-- 有任务时的主体区域 -->
  <view class="task-content" wx:if="{{todayTask}}">
    <!-- 任务信息卡片 -->
    <view class="task-card">
      <view class="task-date">{{todayTask.date}}</view>
      <view class="task-title">{{todayTask.title}}</view>
      <view class="task-desc">{{todayTask.description}}</view>
    </view>

    <!-- 打卡操作区 -->
    <view class="checkin-section">
      <text class="section-label">请输入专属口令完成打卡：</text>
      <input class="password-input" 
             placeholder="请输入口令..." 
             value="{{passwordInput}}" 
             bindinput="onInput" />
      <button class="checkin-btn" 
              bindtap="submitCheckin" 
              disabled="{{isCheckingIn}}">
        {{isCheckingIn ? '验证中...' : '提交打卡'}}
      </button>
    </view>
  </view>

  <!-- 🏆 我的徽章区域 (底部显示) -->
  <view class="badges-section">
    <view class="section-title">🏆 我的徽章</view>
    <view class="badge-list">
      <view class="badge-item {{item.owned ? 'active' : ''}}" wx:for="{{myBadges}}" wx:key="id">
        <!-- 圆圈与变灰滤镜 -->
        <view class="badge-circle" style="{{!item.owned ? 'filter: grayscale(100%); opacity: 0.5;' : ''}}">
          <!-- 确保 Emoji 显示并放大 -->
          <text class="emoji">{{item.emoji}}</text>
        </view>
        <!-- 名字颜色动态切换 -->
        <text class="badge-name" style="{{item.owned ? 'color: #d97757; font-weight: bold;' : 'color: #999;'}}">{{item.name}}</text>
      </view>
    </view>
  </view>

</view>