.container { padding: 24rpx; background: #F8F7F5; min-height: 100vh; }

.urgent-block {
  background: #FDF3EF; border-left: 8rpx solid #D97757;
  padding: 24rpx; border-radius: 12rpx; margin-bottom: 24rpx;
}
.urgent-header { font-weight: 600; color: #D97757; margin-bottom: 8rpx; font-size: 28rpx; }
.urgent-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 12rpx; color: #2C2C2C; }
.urgent-content { font-size: 28rpx; color: #4A4A4A; display: block; margin-bottom: 12rpx; line-height: 1.5; }
.urgent-time { font-size: 24rpx; color: #76746F; }

.card {
  background: #FFFFFF; border-radius: 16rpx; padding: 32rpx;
  margin-bottom: 24rpx; 
  border: 1rpx solid #EBEAE5;
  box-shadow: none; 
}
.card-title { font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; color: #2C2C2C; }
.card-text { font-size: 28rpx; line-height: 1.6; color: #4A4A4A; }

.empty-tip { text-align: center; color: #76746F; padding: 20rpx 0; font-size: 28rpx; }

.schedule-item { display: flex; align-items: baseline; margin-bottom: 16rpx; font-size: 28rpx; }
.schedule-item .time { color: #D97757; width: 100rpx; font-weight: 500; }
.schedule-item .course { flex: 1; color: #2C2C2C; }
.schedule-item .teacher { color: #76746F; font-size: 24rpx; }

.countdown { text-align: center; padding: 20rpx 0; }
.countdown-text { font-size: 44rpx; font-weight: 600; color: #D97757; }