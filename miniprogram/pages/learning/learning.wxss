page { 
  background: #f8f8f8; 
}
.container { 
  padding: 40rpx; 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
}
.header { 
  margin-bottom: 60rpx; 
  margin-top: 20rpx; 
}
.title { 
  font-size: 40rpx; 
  font-weight: bold; 
  color: #333; 
}

.empty-state, .loading-state { 
  margin-top: 100rpx; 
  color: #999; 
  font-size: 28rpx; 
}

/* 3D 翻转容器 */
.card-container {
  width: 100%;
  height: 800rpx;
  perspective: 1000px; /* 提供3D空间透视 */
}

.flashcard {
  width: 100%;
  height: 100%;
  position: relative;
  transition: transform 0.8s cubic-bezier(0.4, 0.2, 0.2, 1);
  transform-style: preserve-3d;
}

.flashcard.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden; /* 隐藏背面 */
  border-radius: 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 正面样式：渐变色背景 */
.card-front {
  background: linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%);
  color: #fff;
}

/* 背面样式：白底蓝边 */
.card-back {
  background: #fff;
  transform: rotateY(180deg);
  border: 6rpx solid #66a6ff;
}

.word-en { 
  font-size: 88rpx; 
  font-weight: bold; 
  margin-bottom: 60rpx; 
  text-shadow: 0 4rpx 10rpx rgba(0,0,0,0.15); 
}
.tap-tip { 
  font-size: 28rpx; 
  opacity: 0.85; 
}

.word-zh { 
  font-size: 80rpx; 
  font-weight: bold; 
  color: #333; 
  margin-bottom: 80rpx; 
}

.password-box {
  background: #f0f4ff;
  padding: 40rpx 80rpx;
  border-radius: 24rpx;
  text-align: center;
}

.pwd-label { 
  display: block; 
  font-size: 26rpx; 
  color: #66a6ff; 
  margin-bottom: 16rpx; 
  font-weight: bold;
}
.pwd-value { 
  display: block; 
  font-size: 56rpx; 
  font-weight: bold; 
  color: #d97757; 
  letter-spacing: 6rpx; 
}